PORT=3000
NODE_ENV=development

CORS_ORIGINS=http://localhost:5173
CORS_CREDENTIALS=true
CORS_ALLOW_NO_ORIGIN=true
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-File-Name,X-Original-File-Name

DATABASE_URL=postgresql://user:password@localhost:5432/database
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_SSL_CA_CERT=
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

AUTH_TOKEN_SECRET=replace-with-at-least-32-random-bytes
AUTH_TOKEN_EXPIRES_IN_SECONDS=43200
AUTH_COOKIE_NAME=arca_session
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000

FRONTEND_URL=https://arcastudio.netlify.app
# En producción, configura el dominio de tu frontend real.
# FRONTEND_URL=https://arcastudio.netlify.app
PASSWORD_RESET_EXPIRES_IN_SECONDS=900
RESEND_API_KEY=replace-with-resend-api-key
MAIL_FROM=ARCA Studio <no-reply@yourdomain.com>
# Optional alternative sender variable used by some deployments
# RESEND_FROM_EMAIL=ARCA Studio <no-reply@yourdomain.com>

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
SUPABASE_STORAGE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_S3_REGION=us-east-1
SUPABASE_STORAGE_S3_ACCESS_KEY_ID=replace-with-storage-access-key-id
SUPABASE_STORAGE_S3_SECRET_ACCESS_KEY=replace-with-storage-secret-access-key
SUPABASE_STORAGE_BUCKET=replace-with-bucket-name
FILE_UPLOAD_LIMIT=50mb
FILE_UPLOAD_MAX_BYTES=52428800
