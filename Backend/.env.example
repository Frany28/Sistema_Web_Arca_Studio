PORT=3000
NODE_ENV=development

CORS_ORIGINS=http://localhost:5173
CORS_CREDENTIALS=true
CORS_ALLOW_NO_ORIGIN=true

DATABASE_URL=postgresql://user:password@localhost:5432/database
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_SSL_CA_CERT=
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

AUTH_TOKEN_SECRET=replace-with-at-least-32-random-bytes
AUTH_TOKEN_EXPIRES_IN_SECONDS=43200
AUTH_COOKIE_NAME=arca_session
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
